{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Synt744/openwrt-singbox-feed/blob/main/config/sources.schema.json",
  "title": "OpenWrt sing-box source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "url", "format", "enabled", "trust", "maxBytes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
          "kind": { "enum": ["github-raw", "subscription"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "revision": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
          "format": { "enum": ["sing-box-json", "share-links"] },
          "enabled": { "type": "boolean" },
          "trust": { "const": "untrusted" },
          "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "github-raw" } }, "required": ["kind"] },
            "then": { "required": ["revision"] }
          }
        ]
      }
    }
  }
}
